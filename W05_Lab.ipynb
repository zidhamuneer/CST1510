# D7
class Record:
    def __init__(self, label, value, limit):
        self.label = label
        self.value = value
        self.limit = limit

    def summary(self):
        return f"{self.label}:{self.value}/{self.limit}"
    def percent(self):
        return(self.value/self.limit)*100
    def status(self):
