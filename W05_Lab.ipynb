# ====================================================================== CLASS
# 1. Define a class called Record.

class Record:
    def __init__(self, label, value, limit):
        """Store label, value and limit on this object."""
        self.label = label
        self.value = value
        self.limit = limit      

    def status(self):
        """Return OVER LIMIT, WARNING or OK."""
        percent = (self.value / self.limit) * 100

        if percent >= 100:
            return "OVER LIMIT"
        elif percent >= 90:
            return "WARNING"
        else:
            return "OK"


# ==================================================================== RECORDS
# 2. Create your records.

def load_records(path):
    """Read label,value,limit lines from a file and return a list of Records."""
    records = []
    with open(path) as f:
        for line in f:
            label, value, limit = line.strip().split(",")
            records.append(Record(label, float(value), float(limit)))
    return records


records = load_records(r"C:\Users\dell\Downloads\Week 05 - Classes and Objects\Week 05 - Classes and Objects\LAB\mini project.txt")

# ==================================================================== OUTPUT
# 3. Print a report for each record.

over_limit_total = 0

for record in records:
    result = record.status()        # call status() once, keep the answer
    if result == "OVER LIMIT":
        over_limit_total += 1

    print()
    print("=" * 34)
    print(f"  RECORD CHECK  -  {record.label}")
    print("=" * 34)

    print(f"  Rows loaded   : {record.value}")
    print(f"  Rows expected : {record.limit}")
    print(f"  Status        : {result}")

    print("=" * 34)

print()
print(f"{over_limit_total} of {len(records)} were OVER LIMIT")
